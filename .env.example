APP_ENV=development
APP_NAME=clinical-rag
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
LOG_LEVEL=INFO

# Auth (demo HMAC JWT — replace in production)
JWT_SECRET=change-me-clinical-rag-dev-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEMO_API_TOKEN=demo-token

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=clinical.raw.events
KAFKA_FHIR_TOPIC=clinical.fhir.resources
KAFKA_GROUP_ID=clinical-rag-processor

# FHIR store — SQLite for local; Compose overrides to Postgres
# DATABASE_URL=sqlite:///./data/fhir_store.db
# Docker Compose maps Postgres to host port 5433 (avoids local PG on 5432)
DATABASE_URL=postgresql+psycopg2://clinical:clinical@127.0.0.1:5433/clinical_fhir

# Neo4j (GraphRAG)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ClinicalRAG#dev1

# OpenAI / proprietary LLM bridge
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai

# Hybrid retrieval (BM25 + pgvector dense RRF). Modes: hybrid | bm25 | dense
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_POOL=20
RRF_K=60
EMBEDDING_DIM=384
LOCAL_EMBEDDING_DIM=384
USE_PGVECTOR=true

# Grounding / cite-or-refuse
GROUNDING_REQUIRE_RETRIEVAL=true
GROUNDING_MIN_CHUNKS=1
GROUNDING_REQUIRE_CITATIONS=true

# IodineIQ / ML
IODINEIQ_MODEL_DIR=data/models
RISK_MODEL_PATH=data/models/patient_risk_model.joblib

# Summary generation
SUMMARY_MAX_TOKENS=2048
